{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openarabee.com/schema/v0/abwab.schema.json",
  "title": "OpenArabee reference table: abwāb of one classical scheme",
  "type": "object",
  "required": ["schema_version", "scheme", "title", "collation", "groups", "abwab"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "scheme": { "const": "bina-35" },
    "title": { "type": "string" },
    "collation": { "type": "string", "description": "How and from which copy the table was transcribed." },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label_ar", "label_en", "count"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label_ar": { "$ref": "common.schema.json#/$defs/arFact" },
          "label_en": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "abwab": { "type": "array", "items": { "$ref": "#/$defs/bab" } }
  },
  "$defs": {
    "forms": {
      "type": "object", "required": ["past", "imperfect"], "additionalProperties": false,
      "properties": {
        "past": { "$ref": "common.schema.json#/$defs/arFact" },
        "imperfect": { "$ref": "common.schema.json#/$defs/arFact" },
        "masdar": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/arFact" } }
      }
    },
    "bab": {
      "type": "object",
      "required": ["id", "number", "group", "number_in_group", "wazn", "mawzun", "bina", "western"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/babId" },
        "number": { "type": "integer", "minimum": 1, "maximum": 35 },
        "group": { "type": "string" },
        "number_in_group": { "type": "integer", "minimum": 1 },
        "wazn": { "$ref": "#/$defs/forms", "description": "The pattern on ف ع ل." },
        "mawzun": { "$ref": "#/$defs/forms", "description": "The model verb the scheme gives for the pattern." },
        "bina": {
          "description": "What the scheme says the pattern is built for (transitivity or meaning), in its own words, plus a reading aid.",
          "type": "object", "required": ["ar", "transitivity"], "additionalProperties": false,
          "properties": {
            "ar": { "$ref": "common.schema.json#/$defs/arFact" },
            "transitivity": { "enum": ["mostly-transitive", "transitive-only", "intransitive-only", "not-stated"] },
            "en": { "type": "string" }
          }
        },
        "condition": { "$ref": "common.schema.json#/$defs/textFact" },
        "examples": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/arFact" } },
        "western": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["scheme", "value", "relation", "src", "status"], "additionalProperties": false,
            "properties": {
              "scheme": { "const": "wright" },
              "value": { "$ref": "common.schema.json#/$defs/formId" },
              "relation": { "description": "exact: same pattern. vowel-class: one of the vowel classes of Form I. subsumed: a mulḥaq pattern that Western grammars treat under this Form.", "enum": ["exact", "vowel-class", "subsumed"] },
              "src": { "$ref": "common.schema.json#/$defs/src" },
              "status": { "$ref": "common.schema.json#/$defs/status" },
              "note": { "type": "string" }
            }
          }
        },
        "note": { "type": "string" }
      }
    }
  }
}
